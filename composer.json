{
    "name": "catlabinteractive/events",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-simplexml": "*",
        "airbrake/phpbrake": "^1.0",
        "barryvdh/laravel-debugbar": "^4.0",
        "barryvdh/laravel-dompdf": "^3.1",
        "catlabinteractive/central-storage-client": "~1.0.3",
        "catlabinteractive/charon-laravel": "^1.12",
        "catlabinteractive/eukles-client": "^1.0.12",
        "catlabinteractive/laravel-catlab-accounts": "^4.3",
        "catlabinteractive/laravel-charon-frontend": "^1.10",
        "catlabinteractive/laravel-table": "^1.1",
        "fab1en/rocket-chat-rest-client": "dev-master",
        "guzzlehttp/oauth-subscriber": "^0.8.1",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.9",
        "laravel/ui": "^4.0",
        "league/oauth1-client": "^1.8",
        "paynl/sdk": "^1.5",
        "spatie/laravel-referer": "^1.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
